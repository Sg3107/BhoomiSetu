# Copy this file to .env and fill in your actual secrets.
# NEVER commit the real .env file — it is listed in .gitignore.

PORT=3000

# Generate strong random secrets (e.g. `openssl rand -base64 48`)
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_STRING

# Live Render Backend URL
RENDER_BACKEND_URL=https://bhoomisetu-backend-8fc1.onrender.com

# Cloudinary permanent cloud storage for verification documents & deeds
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Apps Script Webhook (Sends directly from bhoomisetu.official@gmail.com over HTTPS Port 443!)
GOOGLE_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec

# Email Service (Nodemailer Gmail SMTP - Local Development)
EMAIL_USER=bhoomisetu.official@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_FROM="BhoomiSetu" <bhoomisetu.official@gmail.com>
